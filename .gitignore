# dependencies
node_modules/
.pnp
.pnp.js

# builds
.next/
out/
.serve/
build/
dist/

# generated by `npm run images` — rebuild rather than commit ~36 MB of photos
assets/source/
public/img/*
# ...except the manifest: components/Picture.tsx imports it at build time, so a
# fresh checkout (CI, a new machine) needs a copy present even before anyone
# has run `npm run images`, or `next build` fails with "Module not found".
# `npm run optimize` overwrites it with real data; this tracked copy is only
# the fallback that keeps a from-scratch build from crashing.
!public/img/manifest.json

# generated by the build scripts from lib/redirects.ts and content/site.json
public/.htaccess
public/_redirects
public/vercel.json
public/og.png
public/icon-512.png
public/apple-touch-icon.png

# env
.env
.env.local
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo
next-env.d.ts
